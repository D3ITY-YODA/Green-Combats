# frontend-web/.env.example

# ==========================================
# Application Configuration
# ==========================================
NEXT_PUBLIC_APP_NAME=Green Compass

# ==========================================
# API Configuration
# ==========================================
# The base URL for the Green Compass Go backend.
# Do not include a trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8080

# ==========================================
# Maps Configuration
# ==========================================
# Optional: URL for the MapLibre GL JS style JSON.
# If left empty, the app will use a default fallback or list view.
NEXT_PUBLIC_MAP_STYLE_URL=

# ==========================================
# Localization
# ==========================================
# The default locale used if the user's preference cannot be determined.
NEXT_PUBLIC_DEFAULT_LOCALE=en
