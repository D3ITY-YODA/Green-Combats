GC_APP_ENV=local
GC_SERVER_HOST=
GC_SERVER_PORT=8080
GC_SERVER_READ_TIMEOUT=
GC_SERVER_WRITE_TIMEOUT=
GC_SERVER_IDLE_TIMEOUT=
GC_SERVER_SHUTDOWN_TIMEOUT=

# CORS: comma-separated list of browser origins allowed to call the API.
# Render injects the frontend URL here. Use "*" to allow any origin
# (ignored when GC_CORS_ALLOW_CREDENTIALS is true).
GC_CORS_ALLOWED_ORIGINS=
GC_CORS_ALLOW_CREDENTIALS=true

# Automatically apply pending migrations on startup (set true in deployed environments).
GC_RUN_MIGRATIONS=false

GC_LOG_LEVEL=debug
GC_LOG_FORMAT=text
CONFIG_FILE=
GC_DEV_PG_PORT=5432

GC_DATABASE_URL=
GC_DATABASE_MAX_CONNS=
GC_DATABASE_MIN_CONNS=
GC_DATABASE_CONN_MAX_LIFETIME=
GC_DATABASE_IDLE_TIME=
GC_DATABASE_HEALTH_CHECK=

GC_AUTH_SECRET=
GC_AUTH_ACCESS_TTL=
GC_AUTH_REFRESH_TTL=
GC_AUTH_ISSUER=
