# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/
*/build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/
*.ipr
*.iws

# Keystore files
*.jks
*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# OS-specific files
.DS_Store
Thumbs.db

# Gradle wrapper jar (optional, but good to ignore if you download it dynamically, though usually it's committed. We'll keep it ignored if you prefer, or you can add it back. Let's ignore the downloaded zip)
gradle/wrapper/gradle-8.4-bin.zip
